---
import { testimonials } from '../data/site';
// TODO: testimonials are placeholders (see src/data/site.ts). Replace before launch.
---
<section class="section bg-water overflow-hidden">
  <div class="pointer-events-none absolute left-1/2 top-0 h-72 w-[40rem] -translate-x-1/2 rounded-full bg-blue/10 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative">
    <h2 class="h2" data-reveal>What our customers say</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger data-step="140">
      {testimonials.map((t) => (
        <figure class="glass card-lift flex flex-col rounded-2xl p-7">
          <span class="font-display text-6xl leading-none text-blue/30" aria-hidden="true">“</span>
          <blockquote class="-mt-3 flex-1 text-lg">{t.quote}</blockquote>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-line/80 pt-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-blue to-navy font-display text-lg font-bold text-white" aria-hidden="true">{t.name.charAt(0)}</span>
            <span>
              <span class="block font-semibold text-navy">{t.name}, {t.place}</span>
              <span class="text-sm text-stone">{t.service}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
