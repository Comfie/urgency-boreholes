---
// Page title band. No reveal animation: the H1 is usually the Largest Contentful
// Paint on inner pages, so it must paint without waiting for JavaScript.
import type { Crumb } from '../lib/seo';
interface Props { title: string; intro?: string; eyebrow?: string; breadcrumbs?: Crumb[] }
const { title, intro, eyebrow, breadcrumbs } = Astro.props;
---
<section class="bg-water relative overflow-hidden">
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-blue/20 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative py-16 sm:py-22">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <ol class="flex flex-wrap items-center gap-2 text-stone">
          <li><a href="/" class="hover:text-blue hover:underline">Home</a></li>
          {breadcrumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {i === breadcrumbs.length - 1
                ? <span aria-current="page" class="font-semibold text-navy">{c.name}</span>
                : <a href={c.href} class="hover:text-blue hover:underline">{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="mb-3 font-semibold text-blue">{eyebrow}</p>}
    <h1 class="max-w-4xl text-5xl font-bold sm:text-6xl">{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>
