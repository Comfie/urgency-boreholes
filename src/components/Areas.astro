---
import Icon from './Icon.astro';
import { areas, business, whatsappLink } from '../data/site';
---
<section class="section overflow-hidden" id="areas">
  <div class="container-x grid items-center gap-14 lg:grid-cols-[1fr_1.3fr]">
    <div data-reveal="left">
      <h2 class="h2">Areas we serve</h2>
      <p class="lede">
        We are based in {business.address.suburb}, {business.address.city}, and work within {business.radiusKm} km of Centurion.
      </p>

      <!-- Service radius graphic: rings spreading out from Centurion -->
      <div class="relative mx-auto mt-10 aspect-square w-64 sm:w-72" aria-hidden="true">
        {[1, 0.74, 0.48].map((scale, i) => (
          <div
            class="absolute inset-0 m-auto rounded-full border border-blue/25 bg-blue/[0.04]"
            style={`width:${scale * 100}%;height:${scale * 100}%`}
          ></div>
        ))}
        <span class="ripple absolute inset-0 m-auto h-1/3 w-1/3 rounded-full border-2 border-blue/40"></span>
        <div class="absolute inset-0 m-auto flex h-24 w-24 flex-col items-center justify-center rounded-full bg-blue text-white shadow-[var(--shadow-glow-blue)]">
          <Icon name="pin" class="h-5 w-5" />
          <span class="font-display text-lg font-semibold leading-none">Centurion</span>
        </div>
        <span class="glass absolute right-0 top-4 rounded-full px-3 py-1 font-display text-lg font-bold text-navy">{business.radiusKm} km</span>
      </div>
    </div>

    <div class="glass rounded-3xl p-6 sm:p-8" data-reveal>
      <ul class="grid gap-x-6 sm:grid-cols-2" data-stagger="rise" data-step="50">
        {areas.map((area) => (
          <li class="flex items-center gap-3 border-b border-line/80 py-3 text-lg font-medium">
            <Icon name="pin" class="h-5 w-5 text-blue" /> {area}
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <p class="text-stone">Not sure if you're in range? Send us your suburb.</p>
        <a href={whatsappLink('Hi Urgency Boreholes, do you work in my area? My suburb is: ')} class="btn btn-primary" target="_blank" rel="noopener">Check my area</a>
      </div>
    </div>
  </div>
</section>
