---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import RatingBadge from './RatingBadge.astro';
import { business, whatsappLink, telLink } from '../data/site';
import { workImage } from '../lib/images';

const points = [
  'Available 24/7, including weekends',
  `${business.yearsDrilling} years of borehole drilling experience`,
  'Written quote after a site visit',
  'Drilling, pumps, filtration and plumbing in one team',
];
// Depth gauge ticks (decorative). The signature element of the page.
const ticks = [0, 20, 40, 60, 80];
---
<section class="bg-water relative overflow-hidden">
  <!-- Soft light blooms for depth -->
  <div class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-blue/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-48 -left-32 h-[28rem] w-[28rem] rounded-full bg-sky/30 blur-3xl" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-14 py-14 lg:grid-cols-[1.1fr_1fr] lg:py-22" data-stagger data-step="120">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-white/80 bg-white/60 px-4 py-1.5 text-sm font-semibold text-blue shadow-[var(--shadow-soft)] backdrop-blur-md">
        <Icon name="drop" class="h-4 w-4" /> Borehole drilling and water systems in Gauteng
      </p>
      <h1 class="mt-5 text-5xl font-bold sm:text-6xl lg:text-7xl">Borehole water, from drilling to your tap</h1>
      <p class="mt-6 max-w-xl text-lg text-ink/80">
        {business.name} drills, equips and connects boreholes for homes and businesses in Centurion, Midrand and Johannesburg.
        One team handles the drilling, pump, filtration and plumbing.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={whatsappLink()} class="btn btn-whatsapp text-lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp for a quote</a>
        <a href={telLink} class="btn btn-outline text-lg"><Icon name="phone" /> Call {business.phoneDisplay}</a>
      </div>

      <RatingBadge class="mt-6" />

      <ul class="mt-9 grid gap-3 sm:grid-cols-2" data-stagger="rise" data-step="90">
        {points.map((p) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue text-white shadow-[var(--shadow-glow-blue)]"><Icon name="check" class="h-3.5 w-3.5" /></span>
            <span class="font-medium">{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative pl-14 sm:pl-16" data-reveal="zoom">
      <!-- Depth gauge: a measuring line from the surface down to the water strike -->
      <div class="absolute inset-y-0 left-0 w-14 sm:w-16" aria-hidden="true">
        <div class="absolute bottom-10 left-4 top-0 w-px bg-navy/25"></div>
        <div class="gauge-fill absolute bottom-10 left-4 top-0 w-[3px] -translate-x-px origin-top rounded-full bg-gradient-to-b from-sky to-blue"></div>
        {ticks.map((m, i) => (
          <div class="absolute left-4 flex items-center gap-2" style={`top: calc(${(i / (ticks.length - 1)) * 100}% * 0.86)`}>
            <span class="h-px w-3 bg-navy/60"></span>
            <span class="font-display text-sm font-semibold text-navy/70">{m} m</span>
          </div>
        ))}
        <div class="absolute bottom-0 left-0 flex h-8 w-8 items-center justify-center text-blue">
          <span class="ripple absolute inset-0 rounded-full border-2 border-blue/60"></span>
          <span class="ripple ripple-2 absolute inset-0 rounded-full border-2 border-blue/40"></span>
          <Icon name="drop" class="relative h-8 w-8 drop-shadow-[0_6px_10px_rgb(28_116_217/0.5)]" />
        </div>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-3xl shadow-[var(--shadow-deep)] ring-1 ring-white/60">
          <Image
            src={workImage('drilling-rig-residential.jpg')}
            alt="Urgency Boreholes drilling rig and crew drilling a borehole in the driveway of a family home"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 480px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full object-cover"
          />
          <div class="pointer-events-none absolute inset-0 rounded-3xl bg-gradient-to-t from-navy-deep/55 via-transparent to-transparent"></div>
        </div>

        <!-- Floating glass badges -->
        <div class="glass absolute -left-6 bottom-6 flex items-center gap-3 rounded-2xl px-4 py-3 sm:-left-10">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue text-white shadow-[var(--shadow-glow-blue)]">
            <span class="font-display text-2xl font-bold">{business.yearsDrilling}</span>
          </span>
          <span class="text-sm font-semibold leading-tight text-navy">Years drilling<br />boreholes</span>
        </div>
        <div class="glass absolute -right-3 top-6 hidden items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-navy sm:flex">
          <Icon name="clock" class="h-4 w-4 text-blue" /> Available 24/7
        </div>
      </div>
    </div>
  </div>
</section>
