---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business, whatsappLink, telLink } from '../data/site';
import { workImage } from '../lib/images';

const points = [
  `${business.yearsDrilling} years of borehole drilling experience`,
  'Written quote after a site visit',
  'Drilling, pumps, filtration and plumbing in one team',
  `Working within ${business.radiusKm} km of Centurion`,
];
// Depth gauge ticks (decorative). The signature element of the page.
const ticks = [0, 20, 40, 60, 80];
---
<section class="relative overflow-hidden bg-mist">
  <div class="container-x grid items-center gap-12 py-14 lg:grid-cols-[1.1fr_1fr] lg:py-20">
    <div>
      <p class="font-semibold text-blue">Borehole drilling and water systems in Gauteng</p>
      <h1 class="mt-3 text-5xl font-bold sm:text-6xl lg:text-7xl">Borehole water, from drilling to your tap</h1>
      <p class="mt-6 max-w-xl text-lg text-ink/80">
        {business.name} drills, equips and connects boreholes for homes and businesses in Centurion, Midrand and Johannesburg.
        One team handles the drilling, pump, filtration and plumbing.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={whatsappLink()} class="btn btn-whatsapp text-lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp for a quote</a>
        <a href={telLink} class="btn btn-outline text-lg"><Icon name="phone" /> Call {business.phoneDisplay}</a>
      </div>

      <ul class="mt-9 space-y-3">
        {points.map((p) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue text-white"><Icon name="check" class="h-3.5 w-3.5" /></span>
            <span class="font-medium">{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative pl-14 sm:pl-16">
      <!-- Depth gauge: a measuring line from the surface down to the water strike -->
      <div class="depth-gauge absolute inset-y-0 left-0 w-14 sm:w-16" aria-hidden="true">
        <div class="absolute left-4 top-0 bottom-10 w-px bg-navy/25"></div>
        <div class="gauge-fill absolute left-4 top-0 bottom-10 w-[3px] -translate-x-px origin-top bg-blue"></div>
        {ticks.map((m, i) => (
          <div class="absolute left-4 flex items-center gap-2" style={`top: calc(${(i / (ticks.length - 1)) * 100}% * 0.86)`}>
            <span class="h-px w-3 bg-navy/60"></span>
            <span class="font-display text-sm font-semibold text-navy/70">{m} m</span>
          </div>
        ))}
        <div class="absolute bottom-0 left-0 flex items-center gap-1.5 text-blue">
          <Icon name="drop" class="h-8 w-8" />
        </div>
      </div>

      <div class="overflow-hidden rounded-xl shadow-[0_30px_60px_-30px_rgba(10,61,122,0.55)]">
        <Image
          src={workImage('filtration-system-tank.jpg')}
          alt="Borehole water system with a storage tank, softeners and filtration installed beside a house"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 480px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <p class="mt-3 text-sm text-stone">Recent installation: storage tank, softeners and three-stage filtration.</p>
    </div>
  </div>
</section>

<style>
  /* One orchestrated moment: the gauge fills down to the water on load. */
  .gauge-fill { transform: scaleY(0); animation: drill 1.8s cubic-bezier(.6,.05,.3,1) .3s forwards; }
  @keyframes drill { to { transform: scaleY(1); } }
</style>
