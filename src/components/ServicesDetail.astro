---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services, serviceExtras, whatsappLink } from '../data/site';
import { workImage } from '../lib/images';
---
<div>
  {services.map((s, i) => (
    <section id={s.slug} class:list={['section isolate scroll-mt-36 overflow-hidden', i % 2 === 1 && 'bg-water-soft']}>
      <div class="container-x grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class:list={['relative', i % 2 === 1 && 'lg:order-2']} data-reveal="zoom">
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-blue/10 blur-2xl" aria-hidden="true"></div>
          <Image
            src={workImage(s.image)}
            alt={s.imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 540px, 100vw"
            class="aspect-[4/3] w-full rounded-3xl object-cover shadow-[var(--shadow-deep)] ring-1 ring-white/60"
          />
        </div>
        <div data-reveal="rise">
          <h2 class="h2">{s.title}</h2>
          <p class="lede">{s.summary}</p>
          {serviceExtras[s.slug] && (
            <p class="glass mt-6 flex items-start gap-3 rounded-2xl px-5 py-4 text-ink">
              <Icon name="drop" class="mt-0.5 h-5 w-5 shrink-0 text-blue" />
              <span><strong class="font-semibold text-navy">Good for:</strong> {serviceExtras[s.slug].goodFor}</span>
            </p>
          )}
          <h3 class="mt-8 text-xl font-semibold">What's included</h3>
          <ul class="mt-4 space-y-3" data-stagger="left" data-step="90">
            {s.includes.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue/10 text-blue"><Icon name="check" class="h-3.5 w-3.5" /></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            href={whatsappLink(`Hi Urgency Boreholes, I'd like a quote for ${s.short.toLowerCase()}.`)}
            class="btn btn-whatsapp mt-8"
            target="_blank"
            rel="noopener"
          ><Icon name="whatsapp" /> Ask about {s.short.toLowerCase()}</a>
        </div>
      </div>
    </section>
  ))}
</div>
