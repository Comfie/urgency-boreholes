---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services, whatsappLink } from '../data/site';
import { workImage } from '../lib/images';
---
<div class="divide-y divide-line">
  {services.map((s, i) => (
    <section id={s.slug} class="section">
      <div class="container-x grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class:list={[i % 2 === 1 && 'lg:order-2']}>
          <Image
            src={workImage(s.image)}
            alt={s.imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 540px, 100vw"
            class="aspect-[4/3] w-full rounded-xl object-cover"
          />
        </div>
        <div>
          <h2 class="h2">{s.title}</h2>
          <p class="lede">{s.summary}</p>
          <h3 class="mt-8 text-xl font-semibold">What's included</h3>
          <ul class="mt-4 space-y-3">
            {s.includes.map((item) => (
              <li class="flex items-start gap-3">
                <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-blue" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            href={whatsappLink(`Hi Urgency Boreholes, I'd like a quote for ${s.short.toLowerCase()}.`)}
            class="btn btn-whatsapp mt-8"
            target="_blank"
            rel="noopener"
          ><Icon name="whatsapp" /> Ask about {s.short.toLowerCase()}</a>
        </div>
      </div>
    </section>
  ))}
</div>
