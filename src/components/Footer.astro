---
import Icon from './Icon.astro';
import { business, services, telLink, whatsappLink } from '../data/site';
const year = new Date().getFullYear();
const a = business.address;
---
<footer class="bg-navy text-white/85">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <img src="/brand/logo-horizontal-white.svg" alt={business.name} width="200" height="70" class="h-12 w-auto" loading="lazy" />
      <p class="mt-5 max-w-sm">Borehole drilling, pumps, water purification and plumbing for homes and businesses within {business.radiusKm} km of Centurion.</p>
    </div>
    <div>
      <h2 class="text-xl font-semibold text-white">Services</h2>
      <ul class="mt-4 space-y-2">
        {services.map((s) => <li><a class="hover:text-white hover:underline" href={`/services#${s.slug}`}>{s.short}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-xl font-semibold text-white">Contact</h2>
      <ul class="mt-4 space-y-3">
        <li><a class="flex items-center gap-2 hover:text-white" href={telLink}><Icon name="phone" class="h-4 w-4" /> {business.phoneDisplay}</a></li>
        <li><a class="flex items-center gap-2 hover:text-white" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" class="h-4 w-4" /> WhatsApp us</a></li>
        <li><a class="flex items-center gap-2 hover:text-white" href={`mailto:${business.email}`}><Icon name="mail" class="h-4 w-4" /> {business.email}</a></li>
        <li class="flex items-start gap-2"><Icon name="pin" class="mt-1 h-4 w-4 shrink-0" /> <span>{a.street}, {a.suburb}, {a.city}</span></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="container-x py-5 text-sm text-white/65">© {year} {business.legalName}. All rights reserved.</p>
  </div>
</footer>
