---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { workImage } from '../lib/images';
const reasons = [
  {
    title: 'Water when the supply is off',
    body: 'Keep taps, toilets and the kitchen running during municipal outages and maintenance shutdowns.',
  },
  {
    title: 'Lower municipal water use',
    body: 'Use borehole water for the garden, pool and household, and pay for less water from the municipality.',
  },
  {
    title: 'Added value for your property',
    body: 'A working borehole with filtration is a feature buyers and tenants look for.',
  },
];
---
<section class="section relative isolate overflow-hidden bg-navy-deep text-white">
  <Image
    src={workImage('tank-filtration-grey.jpg')}
    alt=""
    widths={[960, 1600]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover opacity-25"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-navy-deep via-navy/90 to-navy-deep/80"></div>
  <div class="pointer-events-none absolute -right-24 top-10 -z-10 h-80 w-80 rounded-full bg-blue/40 blur-3xl" aria-hidden="true"></div>

  <div class="container-x">
    <h2 class="h2 max-w-3xl !text-white" data-reveal>Stop waiting for the municipal water to come back</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger="rise" data-step="140">
      {reasons.map((r) => (
        <div class="glass-dark card-lift rounded-2xl p-7">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/20">
            <Icon name="drop" class="h-6 w-6 text-sky" />
          </span>
          <h3 class="mt-5 text-2xl font-semibold !text-white">{r.title}</h3>
          <p class="mt-2 text-white/80">{r.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
