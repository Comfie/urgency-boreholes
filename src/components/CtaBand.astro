---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import { business, whatsappLink, telLink } from '../data/site';
interface Props { title?: string; body?: string }
const {
  title = 'Ready for your own water supply?',
  body = 'Send us a WhatsApp with your suburb and what you need. We will arrange a site visit and a written quote.',
} = Astro.props;
---
<section class="bg-blue text-white">
  <div class="container-x grid items-center gap-8 py-14 md:grid-cols-[auto_1fr_auto]">
    <LogoMark class="hidden h-20 w-auto md:block" drop="#ffffff" bit="var(--color-blue)" id="cta" />
    <div>
      <h2 class="text-4xl font-bold !text-white sm:text-5xl">{title}</h2>
      <p class="mt-3 max-w-2xl text-white/90">{body}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={whatsappLink()} class="btn btn-light" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
      <a href={telLink} class="btn border-2 border-white text-white hover:bg-white/10"><Icon name="phone" /> {business.phoneDisplay}</a>
    </div>
  </div>
</section>
