---
import Icon from './Icon.astro';
import { business, whatsappLink, telLink } from '../data/site';

const nav = [
  { href: '/services', label: 'Services' },
  { href: '/our-work', label: 'Our work' },
  { href: '/#areas', label: 'Areas' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<div class="hidden bg-navy text-sm text-white/90 md:block">
  <div class="container-x flex h-10 items-center justify-between">
    <p class="flex items-center gap-2"><Icon name="pin" class="h-4 w-4" /> Serving Centurion, Midrand, Pretoria and Johannesburg</p>
    <p class="flex items-center gap-5">
      <span class="flex items-center gap-2"><Icon name="clock" class="h-4 w-4" /> {business.hours}</span>
      <a href={telLink} class="flex items-center gap-2 font-semibold text-white hover:underline"><Icon name="phone" class="h-4 w-4" /> {business.phoneDisplay}</a>
    </p>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="container-x flex h-18 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${business.name} home`}>
      <img src="/brand/logo-horizontal.svg" alt={business.name} width="200" height="70" class="h-11 w-auto sm:h-12" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-medium">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['py-2 hover:text-blue', path === item.href && 'text-blue']}
              aria-current={path === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={whatsappLink()} class="btn btn-whatsapp hidden sm:inline-flex" target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Get a quote
      </a>

      <details class="group relative lg:hidden">
        <summary class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-md border border-line text-navy [&::-webkit-details-marker]:hidden" aria-label="Open menu">
          <Icon name="menu" class="h-6 w-6" />
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 top-14 w-64 rounded-lg border border-line bg-white p-2 shadow-xl">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} class="block rounded-md px-4 py-3 font-medium hover:bg-mist">{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
