---
// Nudges visitors toward the complete system, the most useful outcome for most homes.
import Icon from './Icon.astro';
import { services, whatsappLink } from '../data/site';
---
<section class="section">
  <div class="container-x">
    <div class="relative isolate overflow-hidden rounded-[2rem] bg-gradient-to-br from-navy via-navy to-blue-dark p-8 text-white shadow-[var(--shadow-deep)] sm:p-12" data-reveal="zoom">
      <div class="pointer-events-none absolute -right-20 -top-20 -z-10 h-72 w-72 rounded-full bg-sky/30 blur-3xl" aria-hidden="true"></div>
      <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <h2 class="text-4xl font-bold !text-white sm:text-5xl">The complete borehole system</h2>
          <p class="mt-4 max-w-xl text-lg text-white/85">
            Most customers choose the full package: one team, one quote and one handover, from the first hole to clean water at the tap.
          </p>
          <a
            href={whatsappLink("Hi Urgency Boreholes, I'd like a quote for a complete borehole system.")}
            class="btn btn-light mt-8"
            target="_blank"
            rel="noopener"
          ><Icon name="whatsapp" /> Quote me the complete system</a>
        </div>
        <ol class="space-y-3" data-stagger="left" data-step="120">
          {services.map((s, i) => (
            <li class="glass-dark flex items-center gap-4 rounded-2xl px-5 py-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white font-display text-lg font-bold text-navy">{i + 1}</span>
              <span class="font-semibold">{s.title}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
