---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServicesDetail from '../components/ServicesDetail.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceNav from '../components/ServiceNav.astro';
import PackageBand from '../components/PackageBand.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import Faq from '../components/Faq.astro';
---
<Layout
  title="Borehole Services: Drilling, Pumps, Purification & Plumbing"
  description="Borehole drilling, pump installation and repairs, water purification and filtration, and plumbing connections in Centurion, Midrand, Pretoria and Johannesburg."
>
  <PageHeader
    title="Borehole services"
    intro="From drilling the hole to clean water at the tap. Choose one service or let us handle the whole system."
  />
  <ServiceNav />
  <ServicesDetail />
  <PackageBand />
  <VideoShowcase title="Real jobs, real water" tone="light" />
  <Process />
  <Faq />
  <CtaBand />
</Layout>
