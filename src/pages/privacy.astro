---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { business } from '../data/site';
// Plain-language notice for POPIA section 18 (openness). Review with Paul before
// relying on it; it describes how this website works, not the whole business.
const ga = Boolean(import.meta.env.PUBLIC_GA4_ID);
---
<Layout title="Privacy Notice" description={`How the ${business.name} website handles personal information from quote requests, WhatsApp messages and website statistics, in line with POPIA.`} breadcrumbs={[{ name: 'Privacy', href: '/privacy' }]}>
  <PageHeader title="Privacy notice" intro="How this website handles your information, in plain language." breadcrumbs={[{ name: 'Privacy', href: '/privacy' }]} />
  <section class="section">
    <div class="container-x max-w-3xl space-y-6 text-lg [&_h2]:mt-10 [&_h2]:text-3xl [&_h2]:font-bold [&_a]:text-blue [&_a]:underline">
      <p>{business.name} ("we") respects your privacy and processes personal information in line with the Protection of Personal Information Act (POPIA).</p>

      <h2>Quote requests and messages</h2>
      <p>This website does not store the details you type into the quote form. When you press "Send on WhatsApp", the form opens WhatsApp with your message ready, and nothing is sent until you press send in WhatsApp. Messages, calls and emails you send us are used only to respond to your enquiry, quote and do the work, and are not sold or shared for marketing.</p>

      <h2>Website statistics</h2>
      {ga ? (
        <p>We use Google Analytics to understand how visitors find and use the site, for example which pages are visited and how many people tap the WhatsApp or call buttons. Google Analytics uses cookies, does not store your IP address, and we have switched off advertising features. You can block these cookies in your browser settings or with Google's opt-out add-on.</p>
      ) : (
        <p>If we use website statistics (such as Google Analytics), it is to see which pages are useful and how many people tap the WhatsApp or call buttons. Advertising features are switched off.</p>
      )}

      <h2>Your rights</h2>
      <p>You may ask what personal information we hold about you, ask us to correct or delete it, or object to how we use it. Contact us at <a href={`mailto:${business.email}`}>{business.email}</a>. You may also lodge a complaint with the Information Regulator of South Africa.</p>

      <h2>Contact</h2>
      <p>{business.name}, {business.address.suburb}, {business.address.city}. Phone {business.phoneDisplay}. Email <a href={`mailto:${business.email}`}>{business.email}</a>.</p>
    </div>
  </section>
</Layout>
