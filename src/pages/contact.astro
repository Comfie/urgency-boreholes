---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { business, whatsappLink, telLink } from '../data/site';
import CtaBand from '../components/CtaBand.astro';
const a = business.address;
const mapQuery = encodeURIComponent(`${a.street}, ${a.suburb}, ${a.city}`);
const nextSteps = [
  { title: 'We reply on WhatsApp', body: 'We confirm your area and ask a few quick questions about the property.' },
  { title: 'Site visit', body: 'We check the ground, access for equipment and how you plan to use the water.' },
  { title: 'Written quote', body: 'You get an itemised quote. No work starts until you are happy with it.' },
];
---
<Layout
  title="Contact Us for a Borehole Quote"
  description="Contact Urgency Boreholes on WhatsApp or phone for a borehole, pump, water purification or plumbing quote in Centurion, Midrand and Johannesburg."
>
  <PageHeader title="Get a quote" intro="WhatsApp is the fastest way to reach us. Send your suburb and what you need, and we'll get back to you." />

  <section class="section bg-water-soft">
    <div class="container-x grid items-start gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <ul class="glass space-y-6 rounded-3xl p-7 text-lg" data-stagger="left" data-step="90">
          <li>
            <a href={whatsappLink()} class="flex items-center gap-4 font-semibold hover:text-blue" target="_blank" rel="noopener">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-whatsapp text-white"><Icon name="whatsapp" class="h-6 w-6" /></span>
              WhatsApp {business.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={telLink} class="flex items-center gap-4 font-semibold hover:text-blue">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue text-white"><Icon name="phone" class="h-6 w-6" /></span>
              Call {business.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${business.email}`} class="flex items-center gap-4 font-semibold hover:text-blue">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-navy text-white"><Icon name="mail" class="h-6 w-6" /></span>
              {business.email}
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mist text-navy"><Icon name="pin" class="h-6 w-6" /></span>
            <span>{a.street}, {a.suburb}, {a.city}</span>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mist text-navy"><Icon name="clock" class="h-6 w-6" /></span>
            <span>{business.hours}</span>
          </li>
        </ul>
        <a class="mt-8 inline-block text-blue underline" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener">Open in Google Maps</a>
      </div>
      <QuoteForm />
    </div>
  </section>

  <section class="section pt-0 bg-water-soft">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div data-reveal="left">
        <h2 class="h2">What happens after you message us</h2>
        <ol class="mt-8 space-y-4" data-stagger="rise" data-step="130">
          {nextSteps.map((step, i) => (
            <li class="glass card-lift flex gap-4 rounded-2xl p-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue font-display text-lg font-bold text-white shadow-[var(--shadow-glow-blue)]">{i + 1}</span>
              <span>
                <span class="block font-display text-xl font-semibold text-navy">{step.title}</span>
                <span class="mt-1 block text-stone">{step.body}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
      <div class="relative min-h-80 overflow-hidden rounded-3xl shadow-[var(--shadow-lift)] ring-1 ring-white/70" data-reveal="zoom">
        <iframe
          title={`Map showing ${business.name} in ${a.suburb}, ${a.city}`}
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          class="absolute inset-0 h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <div class="glass pointer-events-none absolute bottom-4 left-4 right-4 flex items-center gap-3 rounded-2xl px-4 py-3 sm:right-auto">
          <Icon name="pin" class="h-5 w-5 text-blue" />
          <span class="text-sm font-semibold text-navy">Based in {a.suburb}, {a.city}</span>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Rather talk it through?" body="Call us and we'll explain the options for your property, no obligation." />
</Layout>
