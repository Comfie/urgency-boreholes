---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import Analytics from '../components/Analytics.astro';
import { business, services } from '../data/site';
import { areaPages } from '../data/areaPages';
import { cleanPath, absoluteUrl, breadcrumbSchema, businessId, websiteId, type Crumb } from '../lib/seo';
// Preload the fonts used above the fold (headings and body text). Without this the
// browser only finds them after parsing the CSS, and the H1 (the LCP element)
// re-renders late when the font swaps in.
import headingFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Keep a page out of Google (404, thank-you pages). */
  noindex?: boolean;
  /** Breadcrumb trail for BreadcrumbList structured data. Home is added automatically. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD objects for this page (Service, FAQPage, ...). */
  schema?: object[];
}
const { title, description, image = '/brand/og-image.png', noindex = false, breadcrumbs, schema = [] } = Astro.props;
const fullTitle = title === business.name ? title : `${title} | ${business.name}`;
const path = cleanPath(Astro.url.pathname);
const canonical = absoluteUrl(path);
const isHome = path === '/';
const a = business.address;

// One business entity, referenced by @id from page-level Service markup.
// Every value here is published on the site; nothing is invented (no ratings,
// prices or certifications until they are real and verifiable).
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': businessId,
  name: business.name,
  url: business.url,
  description: 'Borehole drilling, borehole pump installation and repairs, water filtration and purification, and borehole plumbing for homes and businesses in Centurion and Gauteng.',
  telephone: business.phoneTel,
  email: business.email,
  image: absoluteUrl('/brand/og-image.png'),
  logo: absoluteUrl('/brand/logo-social.png'),
  contactPoint: [
    { '@type': 'ContactPoint', telephone: business.phoneTel, contactType: 'customer service', availableLanguage: 'English', hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '00:00', closes: '23:59' } },
    { '@type': 'ContactPoint', telephone: business.phone2Tel, contactType: 'customer service', availableLanguage: 'English' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.street,
    addressLocality: a.city,
    addressRegion: a.province,
    addressCountry: a.country,
  },
  // Named cities instead of a GeoCircle: the old geoMidpoint was a Place without
  // coordinates, which is not valid for GeoCircle.
  areaServed: [
    ...areaPages.map((p) => ({ '@type': 'City', name: p.name, url: absoluteUrl(`/areas/${p.slug}`) })),
    { '@type': 'AdministrativeArea', name: 'Gauteng' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Borehole services',
    itemListElement: services.flatMap((s) =>
      s.pages.map((pg) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: pg.label, url: absoluteUrl(`/services/${pg.slug}`) },
      })),
    ),
  },
  sameAs: [business.rating.url, ...Object.values(business.social)].filter(Boolean),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: business.name,
  url: business.url,
  inLanguage: 'en-ZA',
  publisher: { '@id': businessId },
};

const jsonLd: object[] = [localBusiness, ...(isHome ? [website] : []), ...schema];
if (breadcrumbs?.length) jsonLd.push(breadcrumbSchema([{ name: 'Home', href: '/' }, ...breadcrumbs]));
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a3d7a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(image)} />
    <meta property="og:image:alt" content={`${business.name}: borehole drilling and water systems in Gauteng`} />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(image)} />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <!-- Flag JS early so reveal-on-scroll content is only hidden when the script can show it again -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <Analytics />
  </head>
  <body class="pb-[4.5rem] md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <MobileActionBar />
    <script>
      import '../scripts/motion';
      import '../scripts/track';
    </script>
  </body>
</html>
